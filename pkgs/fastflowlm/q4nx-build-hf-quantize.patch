+def ensure_chat_template_jinja(output_dir: Path) -> None:
+    """Materialize chat_template.jinja from a multi-template tokenizer_config.json.
+
+    Newer HF repos (e.g. DeepHermes-3) store ``chat_template`` in
+    tokenizer_config.json as a *list* of ``{"name": ..., "template": ...}``
+    dicts (supporting multiple named templates) instead of the older
+    single-string convention. automodel.cpp only reads tokenizer_config's
+    raw chat_template field when no chat_template.jinja file is present in
+    the model directory, and passes it straight into minja::chat_template()
+    expecting a plain string - so a list value crashes the runtime at load
+    time with "type must be string, but is array". _fetch_assets() can only
+    copy a chat_template.jinja that already exists upstream; these repos
+    don't ship one, so extract the "default" (or first) named template here.
+    """
+    path = output_dir / "tokenizer_config.json"
+    if not path.exists() or (output_dir / "chat_template.jinja").exists():
+        return
+    with open(path, encoding="utf-8") as f:
+        cfg = json.load(f)
+    template = cfg.get("chat_template")
+    if not isinstance(template, list):
+        return
+    chosen = next((t for t in template if t.get("name") == "default"), None) or (
+        template[0] if template else None
+    )
+    if not chosen or not isinstance(chosen.get("template"), str):
+        return
+    (output_dir / "chat_template.jinja").write_text(chosen["template"], encoding="utf-8")
+    print(f"[INFO] Wrote chat_template.jinja from tokenizer_config.json's '{chosen.get('name', 'default')}' template")
+
+
 def inject_flm_keys(config: dict, q4nx_config: dict, output_dir: Path, flm_version: Optional[str]):
     """Restructure a source HF config.json into the shape the FLM runtime expects.
 
@@ -1040,6 +1071,7 @@ def assemble_model_assets_hf(
         json.dump(config, f, indent=2, ensure_ascii=False)
 
     ensure_hf_tokenizer_ids(output_dir)
+    ensure_chat_template_jinja(output_dir)
 
