+    def _quantize_hf_weight(self, w: torch.Tensor) -> torch.Tensor:
+        """Quantize a full-precision HF weight matrix to this model's
+        default_tensor_type and pack it into Q4NX layout.
+
+        The HF-safetensors conversion path (_convert_hf) starts from
+        un-quantized weights, unlike the GGUF path where matmul weights
+        usually arrive already block-quantized. This reuses the exact same
+        quantize-then-unpack sequence GGUFTensor._requantize_to() uses for
+        GGUF sources that also need on-the-fly (re)quantization, so both
+        paths produce bit-identical Q4NX packing for the same input values.
+        """
+        rows, cols = w.shape
+        w_np = w.to(torch.float32).contiguous().numpy()
+        data_quantized = quantize(w_np, self.default_tensor_type).copy()
+        if self.default_tensor_type == GGMLQuantizationType.Q4_1:
+            d, m, qw = GGUFTensor.unpack_q4_1(data_quantized, cols)
+        elif self.default_tensor_type == GGMLQuantizationType.Q4_0:
+            d, m, qw = GGUFTensor.unpack_q4_0(data_quantized, cols)
+        elif self.default_tensor_type == GGMLQuantizationType.Q8_0:
+            d, m, qw = GGUFTensor.unpack_q8_0(data_quantized, cols)
+        else:
+            raise ValueError(f"Unsupported default_tensor_type: {self.default_tensor_type}")
+        return self._pack_q4nx(d, m, qw)
+
     def _multi_modal_mm_weight_rearrange(self, weight: torch.Tensor,
                                             kernel_mm_K:int|None, kernel_mm_N:int|None
                                             ) -> torch.Tensor:
