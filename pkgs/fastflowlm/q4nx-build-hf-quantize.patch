# Patch for https://github.com/Atomic-Germ/q4nx-build, pinned to commit
# 90dcda09c9be0fc896562692777b7303c26963be (2026-08-24).
#
# Used to convert NousResearch/DeepHermes-3-Llama-3-{3,8}B-Preview (plain HF
# safetensors, not GGUF) into FastFlowLM's .q4nx format for the 3b/8b models
# shipped in ../vendor. Not vendored/packaged as a Nix derivation here since
# it's a one-off build-time tool, not something the deployed system needs at
# runtime - see the commit that added this file for the fuller rationale.
#
# Fixes two real bugs found in q4nx-build's HF-safetensors conversion path
# (the GGUF conversion path is unaffected and was already correct):
#
# 1. _build_hf_name_map() (q4nx/model_converter.py) never expanded the
#    "{bid}" per-layer placeholder in q4nx_name templates before using them
#    as dict keys, and the only place that *does* expand it
#    (_create_name_maps' bid-range auto-detection) scans self.gguf_tensors,
#    which is empty for an HF-only source. Net effect: every per-layer
#    tensor (all attention/MLP weights, for every architecture using the
#    shared base implementation) was silently dropped from the conversion -
#    only embed_tokens/lm_head/norm survived. Fixed by expanding "{bid}"
#    using num_hidden_layers read directly from the HF config.json.
#
# 2. The HF-safetensors path never actually quantized anything: llama.py's
#    _convert_hf stored every 2D weight matrix as-is (raw bf16), and
#    _export_q4nx_tensors just safetensors-dumps whatever's in
#    self.q4nx_tensors with no packing step. Only the GGUF path called
#    _pack_q4nx(). So even with bug #1 fixed, the output was a full-shape
#    BF16 passthrough mislabeled ".q4nx" (16GB for an 8B model, not the
#    expected ~5-6GB), which the NPU runtime cannot read correctly. Fixed by
#    adding _quantize_hf_weight(), which reuses the same
#    gguf.quantize() -> unpack_q4_1() -> _pack_q4nx() sequence
#    GGUFTensor._requantize_to() already uses for GGUF sources needing
#    on-the-fly requantization, and wiring it into llama.py's _convert_hf
#    for every 2D weight except embed_tokens (kept as a full-precision bf16
#    lookup table) and 1D norm vectors (kept bf16 passthrough) - matching
#    exactly what the GGUF path does for the same tensor categories.
#
# Verified against NousResearch/DeepHermes-3-Llama-3-8B-Preview: without
# these fixes, output was 16GB, all-BF16, 288/291 tensors unmapped. With
# them: 5.7GB, real I8-packed Q4_1 weights, 0 unmapped tensors, size in line
# with the official FastFlowLM/Llama-3.1-8B-NPU2 registry entry's stated
# footprint (5.4GB).
#
# 3. assemble_model_assets_hf() (q4nx/model_assets.py) never writes
#    chat_template.jinja for HF sources whose tokenizer_config.json stores
#    chat_template as a *list* of named templates (newer HF convention,
#    used by DeepHermes-3) rather than a single string - it can only copy a
#    chat_template.jinja that already exists upstream, and these repos
#    don't ship one. automodel.cpp falls back to tokenizer_config.json's raw
#    chat_template field only when no .jinja file is present, and passes it
#    straight into minja::chat_template() expecting a plain string, so
#    `flm run` crashed at load time with "[json.exception.type_error.302]
#    type must be string, but is array". Fixed by ensure_chat_template_jinja(),
#    which extracts the "default" (or first) named template and writes it
#    out as chat_template.jinja when one isn't already present.
#
# Apply with: git apply q4nx-build-hf-quantize.patch (from the repo root of
# a fresh clone at the pinned commit above).
diff --git a/q4nx/model_converter.py b/q4nx/model_converter.py
index 902d649..f00e1f3 100644
--- a/q4nx/model_converter.py
+++ b/q4nx/model_converter.py
@@ -265,14 +265,45 @@ class __Q4NX_Converter(ABC):
 
         Reverses the config's GGUF->Q4NX name_map and fills in the gaps:
         for most converters, Q4NX names are already in HF format.
+
+        Per-layer templates (containing "{bid}") must be expanded per actual
+        layer index. Bug fix: the bid-range auto-detection in
+        _create_name_maps() only scans self.gguf_tensors, which is empty for
+        HF-safetensors sources - so for HF sources we instead read
+        num_hidden_layers directly from the HF config.json. Without this,
+        every per-layer key here is left as the literal, un-expanded
+        "...{bid}..." string, which never matches a real HF tensor name and
+        silently drops every attention/MLP weight from the conversion.
         """
+        num_layers = None
+        if getattr(self, "hf_dir", None) is not None:
+            config_path = self.hf_dir / "config.json"
+            if config_path.is_file():
+                cfg = json.loads(config_path.read_text())
+                num_layers = (
+                    cfg.get("num_hidden_layers")
+                    or cfg.get("n_layer")
+                    or cfg.get("num_layers")
+                )
+
         hf_to_q4nx: Dict[str, str] = {}
         for param_info in self.q4nx_config["name_map"].values():
             q4nx_name = param_info["q4nx_name"]
             # Skip GGUF-only tensors (rope_freqs, etc.)
             if "rope_freqs" in q4nx_name:
                 continue
-            hf_to_q4nx[q4nx_name] = q4nx_name
+            if "{bid}" in q4nx_name:
+                if num_layers is None:
+                    raise ValueError(
+                        "Cannot expand per-layer tensor name "
+                        f"'{q4nx_name}': no num_hidden_layers/n_layer/"
+                        "num_layers field found in HF config.json"
+                    )
+                for bid in range(num_layers):
+                    expanded = q4nx_name.format(bid=bid)
+                    hf_to_q4nx[expanded] = expanded
+            else:
+                hf_to_q4nx[q4nx_name] = q4nx_name
         return hf_to_q4nx
 
     def _convert_hf(self, q4nx_path: str, weights_type: str):
@@ -843,9 +874,31 @@ class __Q4NX_Converter(ABC):
 
         merged = torch.from_numpy(merged)
         return merged
