Add {host} and {gitRoot} to the retain-stamp placeholders (retainTags, retainMetadata,
retainContext), so memories written into one shared bank from several machines say which machine
and which checkout they came from. {gitProject} only names the repo, and two hosts' checkouts of
the same repo can be in very different states.
diff --git src/core/bank.ts src/core/bank.ts
index 0a31a6b..e61f24a 100644
--- a/src/core/bank.ts
+++ b/src/core/bank.ts
@@ -100,6 +100,15 @@ export function projectNameOf(directory: string, sessionRoot?: string): string {
   return gitProjectName(directory, true, sessionRoot);
 }
 
+/** Absolute path of the main worktree's root, for {gitRoot}: worktree-aware like projectNameOf,
+ *  so every linked worktree of a repo stamps the same path. Outside a repository (or when git
+ *  cannot answer) it is the directory the session started in, as for {gitProject}. */
+export function projectRootOf(directory: string, sessionRoot?: string): string {
+  const projectRoot = mainWorktreeRoot(directory, sessionRoot);
+  if (projectRoot.status === "resolved") return projectRoot.root;
+  return nearestExistingDir(sessionRoot || directory) || "unknown";
+}
