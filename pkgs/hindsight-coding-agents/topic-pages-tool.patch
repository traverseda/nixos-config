+  /**
+   * Define a topic page: a standing question about the project (its design principles, how one
+   * part works) whose content the server synthesizes and keeps current, like an initiative page.
+   * The agent states the question; it never writes the page body.
+   *
+   * New topic → a page in the Topics folder. Update (pageId) → the question is replaced, and only
+   * on a page in that folder, so this can never reword a seeded page, an initiative, or a page a
+   * person made in the control plane.
+   */
+  async defineTopicPage(args: {
+    name: string;
+    question: string;
+    pageId?: string;
+    pageTrigger?: PageTrigger;
+  }): Promise<{ page_id: string; updated: boolean }> {
+    const source_query = args.question.trim() + pageScopeRule(this.project);
+    if (args.pageId) {
+      const folder = (await this.tree()).find(
+        (n) => n.kind === "folder" && (n.name || "").toLowerCase() === TOPICS_FOLDER.toLowerCase()
+      );
+      if (!folder?.children?.some((n) => n.kind === "page" && n.id === args.pageId))
+        throw new Error(
+          `${args.pageId} is not a page in the ${TOPICS_FOLDER} folder; only topic pages can be redefined`
+        );
+      const r = await this.req(
+        "PATCH",
+        this.bankUrl(`/knowledge-base/nodes/${encodeURIComponent(args.pageId)}`),
+        { name: args.name, source_query }
+      );
+      if (r.status === 404) throw new Error(`knowledge page not found: ${args.pageId}`);
+      return { page_id: args.pageId, updated: true };
+    }
+    const folderId = await this.ensureFolder(TOPICS_FOLDER);
+    // No tags: a topic cuts across the knowledge tiers, and a page's tags match with `all`.
+    const r = await this.req("POST", this.bankUrl("/knowledge-base/pages"), {
+      name: args.name,
+      source_query,
+      parent_id: folderId,
+      max_tokens: PAGE_MAX_TOKENS,
+      trigger: pageTriggerFor(args.pageTrigger ?? buildPageTrigger(), this.bank, args.name),
+    });
+    const j = (await r.json()) as { page_id?: string; id?: string };
+    const pageId = j.page_id ?? j.id;
+    if (!pageId) throw new Error("the server created the page but returned no id");
+    return { page_id: pageId, updated: false };
+  }
